cabal-version: 3.0
name:          toxsync
synopsis:      Account sync between a Tox user's devices
version:       0.0.1
stability:     experimental
license:       GPL-3.0-only
license-file:  LICENSE
build-type:    Simple
author:        iphy
maintainer:    iphy
copyright:     Copyright (c) 2026 The TokTok Team
homepage:      https://toktok.ltd
category:      Network
description:
  Keeps a Tox account's chats, friends and settings the same on all its
  devices, and pairs new devices with it.

source-repository head
  type:     git
  location: https://github.com/TokTok/hs-toxsync

library
  default-language: Haskell2010
  hs-source-dirs:   src
  ghc-options:      -Wall
  exposed-modules:
    Tox.Sync.Account
    Tox.Sync.Event
    Tox.Sync.Fact
    Tox.Sync.Frame
    Tox.Sync.Id
    Tox.Sync.MessagePack
    Tox.Sync.Pairing
    Tox.Sync.Protocol
    Tox.Sync.Replica
    Tox.Sync.Session
    Tox.Sync.Setting
    Tox.Sync.Store
  build-depends:
      base               <5
    , base16-bytestring  >=1 && <1.1
    , bytestring         <0.13
    , containers         <0.8
    , cryptohash-sha256  <0.12
    , text               <2.2

test-suite testsuite
  type:             exitcode-stdio-1.0
  default-language: Haskell2010
  hs-source-dirs:   test
  main-is:          testsuite.hs
  ghc-options:      -Wall
  build-tool-depends: hspec-discover:hspec-discover
  other-modules:
    Tox.Sync.ConformanceSpec
  build-depends:
      aeson
    , base               <5
    , base16-bytestring
    , bytestring
    , containers
    , directory
    , hspec
    , scientific
    , text
    , toxsync
    , vector
